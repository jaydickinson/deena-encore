<section class="section">
  <div class="wrap related-grid">
    <img src="{{image}}" alt="{{imageAlt}}" loading="lazy" />
    <div class="related-copy" data-reveal>
      <div class="cue">{{eyebrow}}</div>
      <h2>{{title}}</h2>
      <p>{{description}}</p>
      <a class="btn btn-ghost" href="{{ctaHref}}"
        >{{ctaLabel}} <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
</section>

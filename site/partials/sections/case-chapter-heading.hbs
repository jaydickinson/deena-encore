<div class="case-chapter-heading wrap" style="--chapter-colour:{{colour}}">
  <div class="case-chapter-word">
    <span class="case-chapter-number">{{number}}</span>
    <h2 id="{{headingId}}">{{word}}</h2>
    <span class="case-chapter-diamond" aria-hidden="true"></span>
  </div>
  <p>{{description}}</p>
</div>

<section class="section expertise" id="expertise">
  <div class="wrap expertise-grid">
    <div class="expertise-intro" data-reveal>
      <div class="cue">{{eyebrow}}</div>
      <h2>{{title}}</h2>
      {{#if description}}
        <p>{{description}}</p>
      {{/if}}
      <span class="expertise-count" aria-hidden="true">{{items.length}}</span>
    </div>
    <ol class="expertise-list" data-expertise>
      {{#each items}}
        <li class="offer" data-reveal data-reveal-step="{{@index}}">
          <span class="offer-number">{{number}}</span>
          <h3>{{title}}</h3>
          <p>{{description}}</p>
        </li>
      {{/each}}
    </ol>
  </div>
</section>